#!/bin/sh
set -eu

if [ "$(/usr/bin/uname -s)" != "Darwin" ] || [ "$(/usr/bin/uname -m)" != "arm64" ]; then
  echo "Ambient Project Layer plugin package darwin-arm64 requires macOS arm64; this installation cannot run on $(/usr/bin/uname -s)/$(/usr/bin/uname -m)." >&2
  exit 78
fi

script_dir=$(/usr/bin/dirname "$0")
script_dir=$(CDPATH= cd "$script_dir" && pwd -P)
unset NODE_PATH NODE_OPTIONS
exec "$script_dir/node" "$@"
