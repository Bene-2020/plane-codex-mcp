{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/runtime/bin/ambient-node\" \"${PLUGIN_ROOT}/runtime/hook-adapter/index.js\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/runtime/bin/ambient-node\" \"${PLUGIN_ROOT}/runtime/hook-adapter/index.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__ambient_project__(list_projects|record_project_events|acknowledge_no_project_events|decline_project_binding|restore_project_binding)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/runtime/bin/ambient-node\" \"${PLUGIN_ROOT}/runtime/hook-adapter/index.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/runtime/bin/ambient-node\" \"${PLUGIN_ROOT}/runtime/hook-adapter/index.js\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "^other$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/runtime/bin/ambient-node\" \"${PLUGIN_ROOT}/runtime/hook-adapter/index.js\""
          }
        ]
      }
    ]
  }
}
