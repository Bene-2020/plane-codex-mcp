AMBIENT_DB_PATH=./ambient-project-demo.sqlite
# 仅用于显式的本地 fake 测试；Codex Desktop 正式入口必须在用户级 Codex 配置中设置 sdk
PLANE_MODE=fake
PLANE_BASE_URL=https://api.plane.so
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=
# Only used by the standalone apps/service + 4318 development fallback.
SERVICE_PORT=4317
# Set AMBIENT_SESSION_TOKEN in the shell when using the standalone 4318 development fallback.
# The formal plugin creates its own temporary token and dynamic port.
