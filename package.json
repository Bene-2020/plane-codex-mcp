{
  "name": "ambient-project-layer",
  "version": "0.1.0",
  "description": "Capture meaningful Codex work and synchronize it with Plane.",
  "private": true,
  "license": "MIT",
  "author": "Wenyan Wei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bene-2020/plane-codex-mcp.git"
  },
  "homepage": "https://github.com/Bene-2020/plane-codex-mcp#readme",
  "bugs": {
    "url": "https://github.com/Bene-2020/plane-codex-mcp/issues"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm run build:packages && pnpm run build:apps && pnpm run package:plugin",
    "build:packages": "pnpm --filter @ambient/core build && pnpm --filter @ambient/storage build && pnpm --filter @ambient/plane build",
    "build:apps": "pnpm --filter @ambient/service build && pnpm --filter @ambient/mcp build && pnpm --filter @ambient/hook-adapter build && pnpm --filter @ambient/panel build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p apps/panel/tsconfig.json --noEmit",
    "dev:service": "pnpm --filter @ambient/service dev",
    "dev:panel": "pnpm --filter @ambient/panel dev",
    "dev:mcp": "pnpm --filter @ambient/mcp dev",
    "package:plugin": "node scripts/package-plugin.mjs",
    "package:release-asset": "node scripts/package-release-asset.mjs",
    "smoke:plugin": "node scripts/smoke-plugin.mjs",
    "migrate:source-ids": "node --env-file-if-exists=.env scripts/migrate-source-ids.mjs",
    "validate:plugin": "node scripts/validate-plugin-runtime.mjs plugin",
    "verify:release-tag": "node scripts/verify-release-tag.mjs",
    "fetch:node-sidecar": "node scripts/fetch-node-sidecar.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "0.25.12",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
